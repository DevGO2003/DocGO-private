## Error Handling

### Xử lý lỗi chủ động
```python
from fastapi import HTTPException

# Business logic errors
if not user:
    raise HTTPException(status_code=404, detail="Không tìm thấy người dùng")

if user.email != new_email and email_exists(new_email):
    raise HTTPException(status_code=409, detail="Email đã được sử dụng")
```

### Middleware cho lỗi không lường trước
```python
from fastapi import Request
from fastapi.responses import JSONResponse
import logging
import traceback

@app.middleware("http")
async def error_handler(request: Request, call_next):
    try:
        response = await call_next(request)
        return response
    except Exception as e:
        logging.error(f"Unexpected error: {str(e)}")
        logging.error(traceback.format_exc())
        
        return JSONResponse(
            status_code=500,
            content={
                "apiVersion": "v1",
                "statusCode": 500,
                "shortMessage": "Internal Server Error",
                "description": "Đã xảy ra lỗi không lường trước",
                "data": None,
                "timestamp": datetime.utcnow().isoformat() + "Z",
                "requestId": str(uuid4()),
                "path": str(request.url.path)
            }
        )
```

## Pydantic Schemas

### schemas/request.py
```python
from pydantic import BaseModel, Field
from typing import Optional

class ProcessRequest(BaseModel):
    data: Optional[str] = Field(None, description="Dữ liệu text để xử lý")

class ValidateRequest(BaseModel):
    data: Optional[str] = Field(None, description="Dữ liệu text để validate")
```

### schemas/response.py
```python
from pydantic import BaseModel
from typing import Optional, Any
from datetime import datetime
from uuid import uuid4

class RestResponse(BaseModel):
    apiVersion: str = "v1"
    statusCode: int
    shortMessage: str
    description: str
    data: Optional[Any] = None
    timestamp: str = Field(default_factory=lambda: datetime.utcnow().isoformat() + "Z")
    requestId: str = Field(default_factory=lambda: str(uuid4()))
    path: str
```

