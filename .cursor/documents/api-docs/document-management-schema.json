{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Document Management Schema",
  "description": "Schema cho tài liệu trong hệ thống DocGO - File Management Service. Updated with full enums and conditions from merged sample.",
  "type": "object",
  "required": ["id", "overview", "contract", "content", "file", "storage", "versioning", "metadata", "audit"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Định danh duy nhất của tài liệu (format: FILE-YYYY-NNN-TYPE)."
    },
    "overview": {
      "type": "object",
      "required": ["title", "status", "documentType", "contractType", "ownerUserId"],
      "properties": {
        "title": {
          "type": "string",
          "description": "Tiêu đề tài liệu (từ filename hoặc extracted)."
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "DRAFT", "DELETED", "ARCHIVED", "INACTIVE"],
          "description": "Trạng thái tài liệu. Enum: ACTIVE, DRAFT, DELETED, ARCHIVED, INACTIVE."
        },
        "documentType": {
          "type": "string",
          "enum": ["CONTRACT", "INVOICE", "MEMO", "REPORT", "AGREEMENT"],
          "description": "Loại tài liệu. Enum: CONTRACT, INVOICE, MEMO, REPORT, AGREEMENT."
        },
        "contractType": {
          "type": "string",
          "enum": ["SERVICE_AGREEMENT", "PURCHASE_AGREEMENT", "PARTNERSHIP_AGREEMENT", "EMPLOYMENT_CONTRACT", "NDA"],
          "description": "Loại hợp đồng (nếu documentType là CONTRACT; else optional)."
        },
        "category": {
          "type": "string",
          "description": "Danh mục tài liệu (e.g., Hợp đồng, Tài liệu)."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 0,
          "description": "Thẻ phân loại (keywords, searchable)."
        },
        "ownerUserId": {
          "type": "string",
          "description": "ID người sở hữu tài liệu (user hoặc system)."
        },
        "priority": {
          "type": "string",
          "enum": ["HIGH", "MEDIUM", "LOW"],
          "description": "Mức độ ưu tiên. Enum: HIGH, MEDIUM, LOW."
        },
        "confidentiality": {
          "type": "string",
          "enum": ["CONFIDENTIAL", "INTERNAL", "PUBLIC", "RESTRICTED"],
          "description": "Mức độ bảo mật. Enum: CONFIDENTIAL, INTERNAL, PUBLIC, RESTRICTED."
        },
        "language": {
          "type": "string",
          "enum": ["vi", "en", "fr", "zh"],
          "description": "Ngôn ngữ tài liệu. Enum: vi, en, fr, zh (ISO 639-1)."
        },
        "region": {
          "type": "string",
          "enum": ["VN", "US", "EU", "APAC"],
          "description": "Khu vực. Enum: VN, US, EU, APAC (ISO 3166-1 alpha-2)."
        },
        "department": {
          "type": "string",
          "description": "Phòng ban quản lý."
        },
        "project": {
          "type": "string",
          "description": "Dự án liên quan."
        },
        "new": {
          "type": "boolean",
          "description": "Flag document mới tạo (true nếu vừa upload)."
        }
      }
    },
    "contract": {
      "type": "object",
      "description": "Chi tiết hợp đồng (required if documentType == 'CONTRACT'; else null).",
      "properties": {
        "effectiveDate": {
          "type": "string",
          "format": "date-time",
          "description": "Ngày hiệu lực (ISO date; required)."
        },
        "expiryDate": {
          "type": "string",
          "format": "date-time",
          "description": "Ngày hết hạn (ISO date; required)."
        },
        "totalValue": {
          "type": "number",
          "description": "Tổng giá trị hợp đồng (number in currency unit; required)."
        },
        "currency": {
          "type": "string",
          "enum": ["USD", "VND", "EUR", "JPY"],
          "description": "Đơn vị tiền tệ. Enum: USD, VND, EUR, JPY (ISO 4217)."
        },
        "summary": {
          "type": "string",
          "description": "Tóm tắt hợp đồng (max 500 chars)."
        },
        "project": {
          "type": "string",
          "description": "Dự án liên quan."
        },
        "department": {
          "type": "string",
          "description": "Bộ phận quản lý."
        },
        "priority": {
          "type": "string",
          "enum": ["HIGH", "MEDIUM", "LOW"],
          "description": "Ưu tiên hợp đồng. Enum: HIGH, MEDIUM, LOW."
        },
        "confidentiality": {
          "type": "string",
          "enum": ["CONFIDENTIAL", "INTERNAL", "PUBLIC", "RESTRICTED"],
          "description": "Mức bảo mật hợp đồng. Enum: CONFIDENTIAL, INTERNAL, PUBLIC, RESTRICTED."
        },
        "workflow": {
          "type": "object",
          "properties": {
            "currentStage": {
              "type": "string",
              "enum": ["DRAFT", "REVIEW", "APPROVAL", "SIGNED", "EXECUTED", "TERMINATED"],
              "description": "Giai đoạn hiện tại. Enum: DRAFT, REVIEW, APPROVAL, SIGNED, EXECUTED, TERMINATED."
            },
            "stages": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "enum": ["DRAFT", "REVIEW", "APPROVAL", "SIGNED"],
                    "description": "Tên giai đoạn. Enum: DRAFT, REVIEW, APPROVAL, SIGNED."
                  },
                  "status": {
                    "type": "string",
                    "enum": ["COMPLETED", "IN_PROGRESS", "PENDING", "FAILED"],
                    "description": "Trạng thái giai đoạn. Enum: COMPLETED, IN_PROGRESS, PENDING, FAILED."
                  },
                  "completedAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Thời gian hoàn thành (ISO; null nếu pending)."
                  },
                  "startedAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Thời gian bắt đầu (ISO; if in_progress)."
                  },
                  "assignedTo": {
                    "type": "string",
                    "description": "ID user assign."
                  }
                },
                "required": ["name", "status"]
              }
            }
          },
          "required": ["currentStage"]
        },
        "parties": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["id", "name", "type"],
            "properties": {
              "id": {
                "type": "string",
                "description": "ID duy nhất (reference cho riskToParties)."
              },
              "name": {
                "type": "string",
                "description": "Tên bên."
              },
              "type": {
                "type": "string",
                "enum": ["CLIENT", "VENDOR", "PARTNER", "GUARANTOR"],
                "description": "Loại bên. Enum: CLIENT, VENDOR, PARTNER, GUARANTOR."
              },
              "role": {
                "type": "string",
                "description": "Vai trò (e.g., Bên A)."
              },
              "contact": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Email liên hệ."
                  },
                  "phone": {
                    "type": "string",
                    "description": "SĐT."
                  },
                  "address": {
                    "type": "string",
                    "description": "Địa chỉ."
                  }
                }
              },
              "representative": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Tên đại diện."
                  },
                  "position": {
                    "type": "string",
                    "description": "Chức vụ."
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Email đại diện."
                  }
                }
              },
              "taxCode": {
                "type": "string",
                "description": "Mã số thuế."
              }
            }
          }
        },
        "payment": {
          "type": "object",
          "properties": {
            "schedule": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "required": ["milestone", "percentage", "dueDate", "status"],
                "properties": {
                  "milestone": {
                    "type": "string",
                    "description": "Tên mốc thanh toán."
                  },
                  "percentage": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Phần trăm (%) của totalValue."
                  },
                  "amount": {
                    "type": "number",
                    "description": "Số tiền (calculated from totalValue)."
                  },
                  "dueDate": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Hạn chót (ISO date)."
                  },
                  "status": {
                    "type": "string",
                    "enum": ["PENDING", "PAID", "OVERDUE", "CANCELLED"],
                    "description": "Trạng thái thanh toán. Enum: PENDING, PAID, OVERDUE, CANCELLED."
                  }
                }
              }
            },
            "method": {
              "type": "string",
              "enum": ["BANK_TRANSFER", "CREDIT_CARD", "WIRE", "CHECK"],
              "description": "Phương thức thanh toán. Enum: BANK_TRANSFER, CREDIT_CARD, WIRE, CHECK."
            },
            "paymentMethod": {
              "type": "string",
              "description": "Mô tả chi tiết phương thức."
            }
          }
        },
        "clauses": {
          "type": "object",
          "properties": {
            "key": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "required": ["name", "description", "content"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Tên điều khoản."
                  },
                  "description": {
                    "type": "string",
                    "description": "Giải thích mô tả."
                  },
                  "content": {
                    "type": "string",
                    "description": "Trích dẫn trực tiếp từ hợp đồng."
                  },
                  "importance": {
                    "type": "string",
                    "enum": ["high", "medium", "low"],
                    "description": "Mức quan trọng. Enum: high, medium, low."
                  },
                  "risk": {
                    "type": "string",
                    "enum": ["low", "medium", "high"],
                    "description": "Rủi ro. Enum: low, medium, high."
                  },
                  "advice": {
                    "type": "string",
                    "description": "Lời khuyên (từ AI Claude)."
                  }
                }
              }
            },
            "unfavorable": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "required": ["name", "description", "content"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Tên điều khoản bất lợi."
                  },
                  "description": {
                    "type": "string",
                    "description": "Giải thích."
                  },
                  "content": {
                    "type": "string",
                    "description": "Trích dẫn."
                  },
                  "risk": {
                    "type": "string",
                    "enum": ["low", "medium", "high"],
                    "description": "Rủi ro. Enum: low, medium, high."
                  },
                  "advice": {
                    "type": "string",
                    "description": "Lời khuyên."
                  }
                }
              }
            },
            "intellectualProperty": {
              "type": "string",
              "description": "Điều khoản IP (string plain)."
            },
            "confidentiality": {
              "type": "string",
              "description": "Điều khoản bảo mật (string plain)."
            },
            "warranty": {
              "type": "string",
              "description": "Điều khoản bảo hành (string plain)."
            },
            "termination": {
              "type": "string",
              "description": "Điều khoản chấm dứt (string plain)."
            }
          }
        },
        "reminders": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["id", "type", "title", "description", "content", "dueDate", "status", "priority"],
            "properties": {
              "id": {
                "type": "string",
                "description": "ID duy nhất."
              },
              "type": {
                "type": "string",
                "enum": ["PAYMENT_DUE", "MILESTONE_REVIEW", "EXPIRY_WARNING", "CONTRACT_RENEWAL"],
                "description": "Loại nhắc nhở. Enum: PAYMENT_DUE, MILESTONE_REVIEW, EXPIRY_WARNING, CONTRACT_RENEWAL."
              },
              "title": {
                "type": "string",
                "description": "Tiêu đề nhắc nhở."
              },
              "description": {
                "type": "string",
                "description": "Giải thích."
              },
              "content": {
                "type": "string",
                "description": "Trích dẫn từ hợp đồng."
              },
              "dueDate": {
                "type": "string",
                "format": "date-time",
                "description": "Hạn chót (ISO)."
              },
              "status": {
                "type": "string",
                "enum": ["PENDING", "SENT", "RESOLVED", "OVERDUE"],
                "description": "Trạng thái. Enum: PENDING, SENT, RESOLVED, OVERDUE."
              },
              "priority": {
                "type": "string",
                "enum": ["HIGH", "MEDIUM", "LOW"],
                "description": "Ưu tiên. Enum: HIGH, MEDIUM, LOW."
              }
            }
          }
        },
        "risk": {
          "type": "object",
          "properties": {
            "riskLevel": {
              "type": "string",
              "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
              "description": "Mức rủi ro tổng. Enum: LOW, MEDIUM, HIGH, CRITICAL."
            },
            "factors": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "required": ["type", "description", "content", "probability", "impact", "riskToParties", "beneficiaries"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["TECHNICAL", "SCHEDULE", "FINANCIAL", "LEGAL", "OPERATIONAL"],
                    "description": "Loại rủi ro. Enum: TECHNICAL, SCHEDULE, FINANCIAL, LEGAL, OPERATIONAL."
                  },
                  "description": {
                    "type": "string",
                    "description": "Mô tả rủi ro."
                  },
                  "content": {
                    "type": "string",
                    "description": "Trích dẫn từ hợp đồng."
                  },
                  "probability": {
                    "type": "string",
                    "enum": ["LOW", "MEDIUM", "HIGH"],
                    "description": "Xác suất. Enum: LOW, MEDIUM, HIGH."
                  },
                  "impact": {
                    "type": "string",
                    "enum": ["LOW", "MEDIUM", "HIGH"],
                    "description": "Tác động. Enum: LOW, MEDIUM, HIGH."
                  },
                  "riskToParties": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["name"],
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "ID từ parties (null nếu không match)."
                        },
                        "name": {
                          "type": "string",
                          "description": "Tên bên bị ảnh hưởng."
                        }
                      }
                    },
                    "description": "Rủi ro ảnh hưởng đến ai (reference parties.id)."
                  },
                  "beneficiaries": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["name"],
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "ID từ parties (null nếu không match)."
                        },
                        "name": {
                          "type": "string",
                          "description": "Tên bên hưởng lợi."
                        }
                      }
                    },
                    "description": "Ai lợi từ rủi ro (empty [] nếu không ai)."
                  }
                }
              }
            },
            "mitigationProposals": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "required": ["description", "content", "cost", "timeline", "assignedTo"],
                "properties": {
                  "description": {
                    "type": "string",
                    "description": "Mô tả phương án giảm thiểu."
                  },
                  "content": {
                    "type": "string",
                    "description": "Trích dẫn hỗ trợ từ hợp đồng."
                  },
                  "cost": {
                    "type": "string",
                    "enum": ["LOW", "MEDIUM", "HIGH"],
                    "description": "Chi phí. Enum: LOW, MEDIUM, HIGH."
                  },
                  "timeline": {
                    "type": "string",
                    "description": "Thời gian thực hiện (e.g., '2 tuần')."
                  },
                  "assignedTo": {
                    "type": "string",
                    "description": "Bên chịu trách nhiệm (e.g., 'Bên A')."
                  }
                }
              }
            },
            "advice": {
              "type": "string",
              "description": "Lời khuyên tổng quát (từ AI Claude)."
            }
          },
          "required": ["riskLevel", "factors"]
        },
        "compliance": {
          "type": "object",
          "properties": {
            "regulations": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Danh sách quy định pháp lý."
            },
            "certifications": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Chứng nhận (e.g., ISO 27001)."
            },
            "auditSchedule": {
              "type": "string",
              "format": "date-time",
              "description": "Lịch audit (ISO date)."
            },
            "complianceStatus": {
              "type": "string",
              "enum": ["COMPLIANT", "NON_COMPLIANT", "PENDING_REVIEW", "IN_AUDIT"],
              "description": "Trạng thái tuân thủ. Enum: COMPLIANT, NON_COMPLIANT, PENDING_REVIEW, IN_AUDIT."
            },
            "status": {
              "type": "string",
              "enum": ["compliant", "non_compliant"],
              "description": "Trạng thái legacy (prefer complianceStatus)."
            },
            "issues": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Vấn đề tuân thủ."
            },
            "recommendations": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Khuyến nghị tuân thủ."
            }
          },
          "required": ["complianceStatus"]
        }
      }
    },
    "content": {
      "type": "object",
      "properties": {
        "extractedText": {
          "type": "string",
          "description": "Text đầy đủ extracted (từ OCR nếu PDF)."
        },
        "summary": {
          "type": "string",
          "description": "Tóm tắt AI-generated (max 200 chars)."
        },
        "keyTerms": {
          "type": "array",
          "minItems": 4,
          "items": { "type": "string" },
          "description": "Keywords chính."
        },
        "sections": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["title", "description", "content"],
            "properties": {
              "title": {
                "type": "string",
                "description": "Tiêu đề section."
              },
              "description": {
                "type": "string",
                "description": "Giải thích section."
              },
              "content": {
                "type": "string",
                "description": "Trích dẫn nội dung section."
              },
              "pageNumber": {
                "type": "integer",
                "description": "Số trang (null cho non-PDF)."
              }
            }
          }
        },
        "plaintext": {
          "type": "string",
          "description": "Nội dung plain text (cho non-PDF)."
        },
        "ocr": {
          "type": "object",
          "description": "OCR results (required if file.type starts with 'image/' or 'application/pdf'; else null).",
          "properties": {
            "text": {
              "type": "string",
              "description": "Text từ OCR."
            },
            "status": {
              "type": "string",
              "enum": ["COMPLETED", "FAILED", "PROCESSING"],
              "description": "Trạng thái OCR. Enum: COMPLETED, FAILED, PROCESSING."
            }
          }
        },
        "classification": {
          "type": "object",
          "properties": {
            "isContract": {
              "type": "boolean",
              "description": "Flag là hợp đồng."
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Độ tin cậy (0-1)."
            },
            "category": {
              "type": "string",
              "description": "Danh mục (Enum: Hợp đồng, Tài liệu, Hóa đơn)."
            },
            "language": {
              "type": "string",
              "enum": ["vi", "en"],
              "description": "Ngôn ngữ detected. Enum: vi, en."
            }
          }
        },
        "processing": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["COMPLETED", "PROCESSING", "FAILED"],
              "description": "Trạng thái xử lý. Enum: COMPLETED, PROCESSING, FAILED."
            },
            "error": {
              "type": ["string", "null"],
              "description": "Lỗi nếu có."
            }
          }
        },
        "jsonContent": {
          "type": "object",
          "description": "Nội dung JSON nếu file là JSON (null cho PDF/non-JSON)."
        },
        "jsonAnalysisStatus": {
          "type": "string",
          "enum": ["PARSED", "INVALID", "PENDING"],
          "description": "Trạng thái phân tích JSON. Enum: PARSED, INVALID, PENDING (null cho non-JSON)."
        }
      }
    },
    "file": {
      "type": "object",
      "required": ["id", "name", "type", "size"],
      "properties": {
        "id": {
          "type": "string",
          "description": "ID file."
        },
        "name": {
          "type": "string",
          "description": "Tên file."
        },
        "type": {
          "type": "string",
          "description": "MIME type (e.g., application/pdf). Determines conditions for metadata/ocr."
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "description": "Kích thước (bytes)."
        },
        "hash": {
          "type": "object",
          "properties": {
            "md5": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$",
              "description": "MD5 hash."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "SHA256 hash."
            }
          },
          "required": ["md5", "sha256"]
        },
        "permissions": {
          "type": "object",
          "properties": {
            "read": {
              "type": "array",
              "items": { "type": "string" },
              "description": "User IDs có quyền đọc."
            },
            "write": {
              "type": "array",
              "items": { "type": "string" },
              "description": "User IDs có quyền viết."
            },
            "delete": {
              "type": "array",
              "items": { "type": "string" },
              "description": "User IDs có quyền xóa."
            },
            "share": {
              "type": "array",
              "items": { "type": "string" },
              "description": "User IDs có quyền share."
            }
          }
        },
        "security": {
          "type": "object",
          "properties": {
            "encryption": {
              "type": "string",
              "enum": ["AES-256", "AES-128", "NONE"],
              "description": "Phương thức mã hóa. Enum: AES-256, AES-128, NONE."
            },
            "watermark": {
              "type": "boolean",
              "description": "Có watermark."
            },
            "digitalSignature": {
              "type": "boolean",
              "description": "Có chữ ký số."
            },
            "accessLogging": {
              "type": "boolean",
              "description": "Log truy cập."
            }
          }
        },
        "version": {
          "type": "integer",
          "description": "Phiên bản file (int)."
        }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "location": {
          "type": "string",
          "description": "Vị trí lưu trữ chính (e.g., S3 path)."
        },
        "backupLocations": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string" },
          "description": "Vị trí backup (ít nhất 2)."
        },
        "retentionPolicy": {
          "type": "object",
          "properties": {
            "duration": {
              "type": "string",
              "description": "Thời gian lưu (e.g., '7 years')."
            },
            "autoDelete": {
              "type": "boolean",
              "description": "Tự xóa sau duration."
            },
            "archiveAfter": {
              "type": "string",
              "description": "Archive sau thời gian (e.g., '2 years')."
            }
          },
          "required": ["duration"]
        },
        "accessControl": {
          "type": "object",
          "properties": {
            "public": {
              "type": "boolean",
              "description": "Public access."
            },
            "restrictedUsers": {
              "type": "array",
              "items": { "type": "string" },
              "description": "User bị hạn chế."
            },
            "ipWhitelist": {
              "type": "array",
              "items": { "type": "string" },
              "description": "IP whitelist (CIDR)."
            }
          }
        },
        "s3": {
          "type": "object",
          "description": "Chi tiết S3 (required if storage is S3).",
          "properties": {
            "url": {
              "type": "string",
              "description": "URL presigned."
            },
            "bucket": {
              "type": "string",
              "description": "Tên bucket."
            },
            "objectKey": {
              "type": "string",
              "description": "Object key."
            },
            "region": {
              "type": "string",
              "enum": ["us-east-1", "us-west-2", "eu-west-1", "ap-southeast-1"],
              "description": "S3 region. Enum: us-east-1, us-west-2, eu-west-1, ap-southeast-1."
            },
            "contentType": {
              "type": "string",
              "description": "MIME type."
            },
            "size": {
              "type": "integer",
              "description": "Size (bytes)."
            },
            "versionId": {
              "type": "string",
              "description": "S3 version ID (null if disabled)."
            },
            "checksum": {
              "type": "object",
              "properties": {
                "originalMD5": {
                  "type": "string",
                  "description": "MD5 gốc."
                },
                "archiveMD5": {
                  "type": "string",
                  "description": "MD5 archived (null if not archived)."
                }
              }
            }
          }
        },
        "local": {
          "type": "object",
          "description": "Local storage details (required if storage is local; else null).",
          "properties": {
            "path": {
              "type": "string",
              "description": "Đường dẫn local (null if not local)."
            },
            "filename": {
              "type": "string",
              "description": "Tên file local."
            },
            "mimeType": {
              "type": "string",
              "description": "MIME type."
            },
            "size": {
              "type": "integer",
              "description": "Size (bytes)."
            },
            "mtime": {
              "type": "string",
              "format": "date-time",
              "description": "Modified time (ISO; null if not applicable)."
            },
            "revision": {
              "type": "string",
              "description": "Revision number (null if not versioned)."
            }
          }
        }
      }
    },
    "versioning": {
      "type": "object",
      "properties": {
        "currentVersionInfo": {
          "type": "object",
          "properties": {
            "tag": {
              "type": "string",
              "description": "Version tag (e.g., '1.0')."
            },
            "number": {
              "type": "integer",
              "description": "Version number (int)."
            }
          },
          "required": ["tag", "number"]
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string",
                "description": "Version string."
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "description": "Thời gian tạo (ISO)."
              },
              "createdBy": {
                "type": "string",
                "description": "ID user tạo."
              },
              "changes": {
                "type": "string",
                "description": "Tóm tắt thay đổi."
              },
              "fileId": {
                "type": "string",
                "description": "ID file version."
              }
            },
            "required": ["version", "createdAt", "createdBy"]
          }
        },
        "changeLog": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string",
                "description": "Version."
              },
              "date": {
                "type": "string",
                "format": "date-time",
                "description": "Ngày thay đổi (ISO)."
              },
              "author": {
                "type": "string",
                "description": "Tác giả."
              },
              "changes": {
                "type": "string",
                "description": "Thay đổi."
              }
            },
            "required": ["version", "date", "author"]
          }
        },
        "previousVersion": {
          "type": "string",
          "description": "Version trước (null if first)."
        },
        "changeSummary": {
          "type": "string",
          "description": "Tóm tắt thay đổi tổng (null if none)."
        },
        "changedFields": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Fields thay đổi (e.g., ['title', 'totalValue'])."
        },
        "diff": {
          "type": "object",
          "description": "Diff chi tiết (e.g., { 'title': { old: '...', new: '...' } })."
        },
        "history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "type": "integer",
                "description": "Số version."
              },
              "versionTag": {
                "type": "string",
                "description": "Tag version."
              },
              "changedAt": {
                "type": "string",
                "format": "date-time",
                "description": "Thời gian thay đổi (ISO)."
              },
              "changedBy": {
                "type": "string",
                "description": "Bởi ai."
              },
              "changeType": {
                "type": "string",
                "enum": ["CREATE", "UPDATE", "DELETE", "ARCHIVE"],
                "description": "Loại thay đổi. Enum: CREATE, UPDATE, DELETE, ARCHIVE."
              },
              "storage": {
                "type": "object",
                "properties": {
                  "s3": {
                    "type": "object",
                    "properties": {
                      "versionId": {
                        "type": "string",
                        "description": "S3 version ID (null if disabled)."
                      }
                    }
                  },
                  "local": {
                    "type": "object",
                    "properties": {
                      "revision": {
                        "type": "string",
                        "description": "Local revision (null if not versioned)."
                      }
                    }
                  }
                }
              }
            },
            "required": ["version", "versionTag", "changedAt", "changedBy", "changeType"]
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "fileSystem": {
          "type": "object",
          "properties": {
            "dateModified": {
              "type": "string",
              "format": "date-time",
              "description": "Ngày sửa đổi (ISO; always present)."
            },
            "dateAdded": {
              "type": "string",
              "format": "date-time",
              "description": "Ngày thêm (ISO; always present)."
            },
            "mediaFilename": {
              "type": "string",
              "description": "Tên file trong hệ thống (always present)."
            },
            "originalFilename": {
              "type": "string",
              "description": "Tên file gốc (always present)."
            },
            "originalMD5": {
              "type": "string",
              "description": "MD5 checksum gốc (always present)."
            },
            "originalFileSize": {
              "type": "integer",
              "minimum": 0,
              "description": "Kích thước file gốc (bytes; always present)."
            },
            "originalMimeType": {
              "type": "string",
              "description": "MIME type gốc (always present; determines PDF conditions)."
            },
            "archiveMD5": {
              "type": "string",
              "description": "MD5 archived (null if not archived)."
            },
            "archiveFileSize": {
              "type": "integer",
              "minimum": 0,
              "description": "Kích thước archived (null if not archived)."
            }
          },
          "required": ["dateModified", "dateAdded", "mediaFilename", "originalFilename", "originalMD5", "originalFileSize", "originalMimeType"]
        },
        "originalDocument": {
          "type": "object",
          "description": "Metadata gốc (basic always; PDF-specific if mimeType == 'application/pdf'). Condition: If originalMimeType == 'application/pdf' then populate PDF/XMP; else basic only, xmp/pdf* = null.",
          "properties": {
            "dcFormat": {
              "type": "string",
              "description": "Định dạng (Enum: application/pdf, text/plain, application/json; null for unknown)."
            },
            "dcTitle": {
              "type": "string",
              "description": "Tiêu đề (null for non-PDF)."
            },
            "dcCreator": {
              "type": "string",
              "description": "Người tạo (null for non-PDF)."
            },
            "dcDescription": {
              "type": "string",
              "description": "Mô tả (null for non-PDF)."
            },
            "dcSubject": {
              "type": "string",
              "description": "Chủ đề (null for non-PDF)."
            },
            "xmpCreateDate": {
              "type": "string",
              "format": "date-time",
              "description": "Ngày tạo XMP (null for non-PDF)."
            },
            "xmpCreatorTool": {
              "type": "string",
              "description": "Công cụ XMP (null for non-PDF)."
            },
            "xmpModifyDate": {
              "type": "string",
              "format": "date-time",
              "description": "Ngày sửa XMP (null for non-PDF)."
            },
            "xmpMetadataDate": {
              "type": "string",
              "format": "date-time",
              "description": "Ngày metadata XMP (null for non-PDF)."
            },
            "pdfKeywords": {
              "type": "string",
              "description": "Keywords PDF (null for non-PDF)."
            },
            "pdfProducer": {
              "type": "string",
              "description": "Producer PDF (null for non-PDF, e.g., pikepdf 9.5.2)."
            },
            "xmpDocumentID": {
              "type": "string",
              "description": "ID XMP document (null for non-PDF)."
            },
            "xmpInstanceID": {
              "type": "string",
              "description": "Instance ID XMP (null for non-PDF)."
            },
            "pdfaid:part": {
              "type": "integer",
              "description": "Phiên bản PDF/A part (null for non-PDF; Enum: 1, 2, 3)."
            },
            "pdfaid:conformance": {
              "type": "string",
              "description": "Conformance PDF/A (null for non-PDF; Enum: A, B, U)."
            },
            "dc:creator": {
              "type": "string",
              "description": "Creator DC (null for non-PDF)."
            }
          }
        },
        "archivedDocument": {
          "type": "object",
          "description": "Metadata archived (if archived && PDF; else empty/null). Condition: If originalMimeType == 'application/pdf' && archiveMD5 exists then populate; else {}. For JSON import, empty (no archived PDF).",
          "properties": {
            "archivedPdfProducer": {
              "type": "string",
              "description": "Producer archived PDF (null/non-PDF, e.g., pikepdf 9.5.2)."
            },
            "archivedMetadataDate": {
              "type": "string",
              "format": "date-time",
              "description": "Metadata date archived (null/non-PDF)."
            },
            "archivedModifyDate": {
              "type": "string",
              "format": "date-time",
              "description": "Modify date archived (null/non-PDF)."
            },
            "archivedCreateDate": {
              "type": "string",
              "format": "date-time",
              "description": "Create date archived (null/non-PDF)."
            },
            "archivedCreatorTool": {
              "type": "string",
              "description": "Creator tool archived (null/non-PDF, e.g., OCRmyPDF)."
            },
            "archivedDocumentID": {
              "type": "string",
              "description": "ID archived (null/non-PDF)."
            },
            "archivedDcFormat": {
              "type": "string",
              "description": "Format archived (Enum: application/pdf; null/non-PDF)."
            },
            "archivedDcTitle": {
              "type": "string",
              "description": "Title archived (null/non-PDF)."
            },
            "archivedDcCreator": {
              "type": "string",
              "description": "Creator archived (null/non-PDF)."
            },
            "archivedXmpMetadataDate": {
              "type": "string",
              "format": "date-time",
              "description": "XMP metadata archived (null/non-PDF)."
            },
            "archivedXmpModifyDate": {
              "type": "string",
              "format": "date-time",
              "description": "XMP modify archived (null/non-PDF)."
            },
            "archivedXmpCreateDate": {
              "type": "string",
              "format": "date-time",
              "description": "XMP create archived (null/non-PDF)."
            },
            "archivedXmpCreatorTool": {
              "type": "string",
              "description": "XMP creator archived (null/non-PDF)."
            },
            "archivedXmpMMDocumentID": {
              "type": "string",
              "description": "XMP MM ID archived (null/non-PDF)."
            },
            "archivedDcFormat": {
              "type": "string",
              "description": "DC format archived (null/non-PDF)."
            },
            "archivedPdfaidPart": {
              "type": "integer",
              "description": "PDF/A part archived (null/non-PDF; Enum: 1, 2, 3)."
            },
            "archivedPdfaidConformance": {
              "type": "string",
              "description": "Conformance archived (null/non-PDF; Enum: A, B, U)."
            },
            "archivedDcCreator": {
              "type": "string",
              "description": "DC creator archived (null/non-PDF)."
            }
          }
        },
        "technical": {
          "type": "object",
          "properties": {
            "encoding": {
              "type": "string",
              "enum": ["UTF-8", "UTF-16", "ASCII"],
              "description": "Encoding (always present)."
            },
            "lineEnding": {
              "type": "string",
              "enum": ["LF", "CRLF", "CR"],
              "description": "Line ending (always present)."
            },
            "bom": {
              "type": "boolean",
              "description": "BOM presence (always present)."
            },
            "compression": {
              "type": "string",
              "enum": ["NONE", "GZIP", "DEFLATE"],
              "description": "Compression (always present)."
            },
            "pages": {
              "type": "integer",
              "minimum": 0,
              "description": "Số trang (null for non-PDF)."
            },
            "wordCount": {
              "type": "integer",
              "minimum": 0,
              "description": "Số từ (null for non-text)."
            },
            "characterCount": {
              "type": "integer",
              "minimum": 0,
              "description": "Số ký tự (null for binary)."
            }
          },
          "required": ["encoding", "lineEnding", "bom", "compression"]
        }
      }
    },
    "audit": {
      "type": "object",
      "required": ["createdAt", "createdBy", "lastModifiedAt", "lastModifiedBy"],
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Tạo lúc (ISO; required)."
        },
        "createdBy": {
          "type": "string",
          "description": "Tạo bởi (user ID; required)."
        },
        "lastModifiedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Sửa cuối (ISO; required)."
        },
        "lastModifiedBy": {
          "type": "string",
          "description": "Sửa bởi (user ID; required)."
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Phiên bản audit (int)."
        },
        "changeHistory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": ["CREATE", "UPDATE", "DELETE", "VIEW", "SHARE"],
                "description": "Hành động. Enum: CREATE, UPDATE, DELETE, VIEW, SHARE."
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "Thời gian (ISO; required)."
              },
              "userId": {
                "type": "string",
                "description": "User ID (required)."
              },
              "details": {
                "type": "string",
                "description": "Chi tiết."
              },
              "ipAddress": {
                "type": "string",
                "description": "IP (optional)."
              },
              "userAgent": {
                "type": "string",
                "description": "User agent (optional)."
              }
            },
            "required": ["action", "timestamp", "userId"]
          }
        },
        "accessLog": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": ["VIEW", "EDIT", "DOWNLOAD", "SHARE", "DELETE"],
                "description": "Hành động truy cập. Enum: VIEW, EDIT, DOWNLOAD, SHARE, DELETE."
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "Thời gian (ISO; required)."
              },
              "userId": {
                "type": "string",
                "description": "User ID (required)."
              },
              "ipAddress": {
                "type": "string",
                "description": "IP (optional)."
              },
              "userAgent": {
                "type": "string",
                "description": "User agent (optional)."
              }
            },
            "required": ["action", "timestamp", "userId"]
          }
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update lúc (ISO; legacy, prefer lastModifiedAt)."
        },
        "updatedBy": {
          "type": "string",
          "description": "Update bởi (legacy)."
        },
        "deletedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Xóa lúc (ISO/null)."
        },
        "deletedBy": {
          "type": "string",
          "description": "Xóa bởi (user ID/null)."
        },
        "isDeleted": {
          "type": "boolean",
          "description": "Flag soft delete."
        }
      }
    },
    "processing": {
      "type": ["object", "null"],
      "description": "Trạng thái xử lý (null if completed; object if ongoing).",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["COMPLETED", "PROCESSING", "FAILED"],
          "description": "Trạng thái. Enum: COMPLETED, PROCESSING, FAILED."
        },
        "error": {
          "type": ["string", "null"],
          "description": "Lỗi nếu có."
        }
      }
    }
  }
}
