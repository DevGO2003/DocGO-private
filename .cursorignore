# VCS & IDE
.git/
.github/
.gitlab/
.idea/
.vscode/
**/*.iml
.DS_Store
Thumbs.db

# Node/JS
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/

# Python
**/venv/
**/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/

# Java/Maven/Gradle
**/target/
**/.mvn/
**/.gradle/

# Caches, logs, temp
**/.cache/
**/logs/
**/*.log
**/tmp/
**/temp/
**/coverage/
**/.nyc_output/

# Large/binary assets and datasets
document/**/*.pdf
document/**/*.doc
document/**/*.docx
document/**/*.xls
document/**/*.xlsx
document/**/*.ppt
document/**/*.pptx
document/**/*.drawio
**/*.zip
**/*.rar
**/*.7z

# Project-specific data dirs
**/uploads/
**/documents/
**/contract_uploads/
**/results/
backend/api-gateway-bff/logs/

# KHÔNG ignore file .env* để Cursor AI có thể track
# (Git vẫn ignore chúng qua .gitignore)
# Explicitly include .env files for Cursor AI
!**/.env
!**/.env.local
!**/.env.*.local
!**/.env.example