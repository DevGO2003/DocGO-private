# ===== Cursor bắt buộc theo dõi các thư mục và file cần thiết =====

# Luôn include toàn bộ thư mục git-backup và tất cả nội dung bên trong
!/.git-backup/
!**/.git-backup/**
 
# Luôn include toàn bộ thư mục .cursor và nội dung bên trong
!/.cursor
!**/.cursor/**

# ===== Ignore các thư mục và file build, cache, log, temp =====

**/.cache/
**/__pycache__/
**/build/
**/dist/
# removed documents folder ignore (no longer used)

# Logs - chỉ ignore file log lớn, giữ lại file log quan trọng để debug
**/logs/*.log
**/logs/debug/
**/logs/temp/
**/logs/old/
**/*.log

# Node modules và build artifacts
**/node_modules/
**/target/
**/temp/
**/tmp/

# ===== Ignore các thư mục VCS =====

!.git/
!.github/
!.gitlab/

# ===== Project-specific items không nằm trong .gitignore =====

document/**/*.drawio

# ===== KHÔNG ignore file .env* để Cursor AI có thể track =====
# (Git vẫn ignore chúng qua .gitignore)
!**/.env
!**/.env.example
!**/.env.local
!**/.env.*.local

# Đảm bảo track cả env trong .cursor/tools
!/.cursor/tools/**/env/.env

# ===== KHÔNG ignore file quan trọng cho debug =====

# Giữ lại file config và setup
!**/config.*
!**/setup.*
!**/*.config.*

# Giữ lại file test và example
!**/test*
!**/*test*
!**/example*
!**/*example*

# Giữ lại file documentation quan trọng
!**/README*
!**/CHANGELOG*
!**/TODO*
!**/NOTES*

# Giữ lại file script và utility
!**/*.sh
!**/*.bat
!**/*.ps1
!**/scripts/**
!**/utils/**

# Giữ lại file log quan trọng cho debug (không ignore toàn bộ logs/)
!**/logs/important/
!**/logs/audit/
!**/logs/error/
!**/logs/app.log
!**/logs/application.log
!**/logs/service.log
