# DocGO Environment Configuration

# MongoDB Configuration
MONGODB_URI=mongodb+srv://root:sapassword@devgo-docgo-cluster0.hsudzga.mongodb.net/?retryWrites=true&w=majority&appName=devgo-docgo-cluster0
MONGODB_LOCAL_URI=mongodb://localhost:27017/docgo

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_FILE_EVENTS=file-events
KAFKA_TOPIC_CONTRACT_EVENTS=contract-events

# Service Ports
USER_MANAGEMENT_SERVICE_PORT=8001
REPOSITORY_MANAGEMENT_SERVICE_PORT=8002
AUTOMATION_SERVICE_PORT=8003
API_GATEWAY_PORT=8000
WEB_APP_PORT=3000

# Service URLs
USER_MANAGEMENT_SERVICE_URL=http://localhost:8001
REPOSITORY_MANAGEMENT_SERVICE_URL=http://localhost:8002
AUTOMATION_SERVICE_URL=http://localhost:8003
API_GATEWAY_URL=http://localhost:8000
WEB_APP_URL=http://localhost:3000

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Security
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=86400

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs

# Development
NODE_ENV=development
SPRING_PROFILES_ACTIVE=dev
