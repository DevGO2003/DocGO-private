# ==========================================
# DOCGO INFRASTRUCTURE CONFIGURATION
# ==========================================
# CHỈ chứa infrastructure secrets được chia sẻ giữa các services
# Service-specific secrets được quản lý trong backend/[service]/.env

# ==========================================
# DATABASE CONFIGURATION (Shared)
# ==========================================
MONGODB_ATLAS_URI=mongodb+srv://root:sapassword@devgo-docgo-cluster0.hsudzga.mongodb.net
MONGODB_USER_DATABASE=docgo_user_service
MONGODB_DOCUMENT_DATABASE=docgo_document_service
MONGODB_AUTOMATION_DATABASE=docgo_automation_service

# ==========================================
# MESSAGE BROKERS (Shared)
# ==========================================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID_PREFIX=docgo
KAFKA_GROUP_ID_PREFIX=docgo-group

# ==========================================
# KAFKA TOPICS - FILE EVENTS (Shared)
# ==========================================
KAFKA_FILE_UPLOADED_TOPIC=file.uploaded
KAFKA_FILE_PROCESSED_TOPIC=file.processed
KAFKA_FILE_UPDATED_TOPIC=file.updated
KAFKA_FILE_CLASSIFIED_TOPIC=file.classified
KAFKA_FILE_ANALYZED_TOPIC=file.analyzed
KAFKA_FILE_DELETED_TOPIC=file.deleted

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# SERVICE URLS (Shared - for Docker internal communication)
# ==========================================
USER_MANAGEMENT_SERVICE_URL=http://user-management-service:8001
DOCUMENT_MANAGEMENT_SERVICE_URL=http://document-management-service:8002
AUTOMATION_SERVICE_URL=http://automation-service:8003

# ==========================================
# SERVICE PORTS (Shared)
# ==========================================
API_GATEWAY_PORT=8000
USER_MANAGEMENT_PORT=8001
DOCUMENT_MANAGEMENT_PORT=8002
AUTOMATION_PORT=8003
WEB_APP_PORT=3000

# ==========================================
# INFRASTRUCTURE PORTS (Shared)
# ==========================================
KAFKA_PORT=9092
REDIS_PORT=6379
KAFKA_UI_PORT=8080
ZOOKEEPER_PORT=2181

# ==========================================
# API GATEWAY CONFIGURATION (Shared)
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ==========================================
# FILE STORAGE CONFIGURATION (Shared)
# ==========================================
FILE_STORAGE_PATH=/app/uploads
RESULTS_PATH=/app/results
MAX_FILE_SIZE=10MB