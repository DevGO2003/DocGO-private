# ==========================================
# DOCUMENT MANAGEMENT SERVICE - SPECIFIC CONFIG
# ==========================================

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8002
SERVER_HOST=0.0.0.0

# Service-specific Redis Configuration
REDIS_DATABASE=0

# Kafka Configuration
SPRING_KAFKA_ENABLED=true

# Dependent Service URLs (Internal Docker Network)
AI_SERVICE_URL=http://ai-processing-service:8000
FILE_SERVICE_URL=http://file-storage-service:8000

# MongoDB Atlas (Metadata storage for documents)
MONGODB_ATLAS_URI=mongodb+srv://root:sapassword@devgo-docgo-cluster0.hsudzga.mongodb.net
MONGODB_DOCUMENT_DATABASE=docgo_document_service

# Logging
LOG_LEVEL=INFO