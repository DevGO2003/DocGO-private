# DocGO Automation Service Environment Configuration
# Copy this file to .env and fill in your values

# ==========================================
# SERVICE CONFIGURATION
# ==========================================
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8003
NODE_ENV=development

# ==========================================
# AI PROVIDERS
# ==========================================
# Primary AI Provider (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash-latest

# Backup AI Provider (OpenRouter)
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
OPENROUTER_FALLBACK_MODELS=meituan/longcat-flash-chat

# ==========================================
# INFRASTRUCTURE SERVICES
# ==========================================
# Kafka Configuration
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID_PREFIX=docgo
KAFKA_GROUP_ID_PREFIX=docgo-group

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# MongoDB Configuration
MONGODB_ENABLED=true
MONGODB_ATLAS_URI=your_mongodb_atlas_uri_here
MONGODB_AUDIT_DATABASE=docgo_automation_audit

# ==========================================
# FILE STORAGE
# ==========================================
# S3 Configuration
S3_ENABLED=true
S3_ENDPOINT=https://s3.filebase.com
S3_REGION=
S3_ACCESS_KEY_ID=your_s3_access_key_here
S3_SECRET_ACCESS_KEY=your_s3_secret_key_here
S3_BUCKET=your_s3_bucket_here

# MinIO Configuration (Local Development)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=docgo-files

# File Processing
UPLOAD_DIR=uploads
TEMP_DIR=temp
MAX_FILE_SIZE=104857600
MAX_SYNC_SIZE=2097152
ALLOWED_FILE_TYPES=pdf,docx,txt,jpg,jpeg,png,gif

# ==========================================
# AI PROCESSING LIMITS
# ==========================================
AI_SUMMARY_MAX_PROMPT_CHARS=180000

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=INFO

# ==========================================
# CORS
# ==========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ==========================================
# SERVICE URLS
# ==========================================
USER_MANAGEMENT_SERVICE_URL=http://localhost:8001
FILE_MANAGEMENT_SERVICE_URL=http://localhost:8002
BASE_URL=http://localhost:8003
