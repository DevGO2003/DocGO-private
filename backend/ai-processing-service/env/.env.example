# AI Processing Service Environment Variables

# Service Configuration
HOST=0.0.0.0
PORT=8017
PYTHONPATH=/app

# Application Configuration
APP_NAME=AI Processing Service
APP_VERSION=1.0.0
DEBUG=true

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# File Upload Configuration
MAX_FILE_SIZE=50MB
SUPPORTED_FORMATS=docx,pdf,txt
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=docx,pdf,txt

# Results Directory
RESULTS_DIR=results

# Logging Configuration
LOG_LEVEL=INFO

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_FILE_UPLOADED_TOPIC=file.uploaded
KAFKA_TEXT_EXTRACTED_TOPIC=ai.text.extracted
KAFKA_DOCUMENT_CLASSIFIED_TOPIC=ai.document.classified
KAFKA_CONTRACT_SUMMARY_TOPIC=contract.summary.updated
KAFKA_CLIENT_ID=ai-processing-service