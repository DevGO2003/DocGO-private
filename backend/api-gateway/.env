# Web App Environment Configuration
NODE_ENV=development
PORT=3001

# API Gateway URL for external access (from host machine)
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8001
# Service URLs for Docker environment
NEXT_PUBLIC_USER_SERVICE_URL=http://user-management-service:8001
NEXT_PUBLIC_DOCUMENT_SERVICE_URL=http://document-management-service:8002
NEXT_PUBLIC_AUTOMATION_SERVICE_URL=http://automation-service:8003

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO