# Contract Management Service Configuration - Local Development

# Application Configuration
APP_NAME=contract-service
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8003

# Database Configuration
DATABASE_URL=jdbc:mariadb://localhost:3306/docgo_contract_service
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=docgo_contract_service
DATABASE_USER=root
DATABASE_PASSWORD=sapassword
DATABASE_DRIVER=org.mariadb.jdbc.Driver

# JPA/Hibernate Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_DIALECT=org.hibernate.dialect.MariaDBDialect

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=contract-service-group

# File Upload Configuration
UPLOAD_DIRECTORY=uploads
MAX_FILE_SIZE=50MB
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=pdf,docx,txt

# Server Configuration
SERVER_PORT=8003

# Logging Configuration
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# Swagger Configuration
SWAGGER_UI_PATH=/docs
LOG_LEVEL=INFO




