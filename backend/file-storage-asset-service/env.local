# File Storage Asset Service Environment Variables - Local Development

# Service Configuration
SERVICE_NAME=file-storage-asset-service
SERVICE_PORT=8019
DEBUG=true

# Database Configuration
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/docgo_file_storage
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=docgo_file_storage
DATABASE_USER=root
DATABASE_PASSWORD=password

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=pdf,docx,txt,jpg,png,xlsx,pptx
TEMP_DIR=./temp

# MinIO/S3 Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=docgo-files
MINIO_SECURE=false

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=file-storage-service
KAFKA_TOPIC=file.events




