# Authentication Identity Service Environment Variables - Local Development

# Service Configuration
SERVICE_NAME=authentication-identity-service
SERVICE_PORT=8001
DEBUG=true

# Database Configuration
DATABASE_URL=mysql+pymysql://root:sapassword@localhost:3306/docgo_auth_service
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=docgo_auth_service
DATABASE_USER=root
DATABASE_PASSWORD=sapassword

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_EXPIRES_IN=24h
JWT_ALGORITHM=HS256

# Password Configuration
PASSWORD_SALT_ROUNDS=12
MIN_PASSWORD_LENGTH=8

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
CORS_ORIGIN=*
ENABLE_COMPRESSION=true
ENABLE_HELMET=true




