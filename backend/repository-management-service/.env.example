# Repository Management Service Environment Variables

# MongoDB Configuration
MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster.mongodb.net/docgo?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DATABASE=docgo

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=docgo-repo-events-v1

# Service Configuration
SERVER_PORT=8002
SPRING_PROFILES_ACTIVE=dev

# Logging
LOGGING_LEVEL_COM_DEVGO2003_DOCGO=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_KAFKA=DEBUG