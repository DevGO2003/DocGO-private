# Repository Management Service Environment Variables
# ==================================================
# DocGO - Repository Management Service (.env.example)
# ==================================================

# --- Application ---
SERVER_PORT=8002

# --- MongoDB Atlas ---
# REQUIRED: Replace <username> and <password> with your actual credentials
MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/docgo?retryWrites=true&w=majority
MONGODB_DATABASE=docgo

# --- Redis Cloud (tuỳ chọn) ---
REDIS_CLOUD_HOST=redis
REDIS_CLOUD_PORT=6379
REDIS_CLOUD_PASSWORD=
REDIS_DB=0

# --- S3 Storage ---
S3_BUCKET=docgo-files
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Swagger ---
SWAGGER_ENABLED=true

