# Dependencies (không include trong build, install trong container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build/cache (rebuild trong container)
.next/
out/
dist/
build/

# Environment secrets (không leak vào image)
.env*.local
.env.production

# Logs và temp (không cần cho dev)
logs/
*.log
tmp/
temp/

# OS/IDE (Windows-specific)
.DS_Store
Thumbs.db
.cache/
.vscode/
.idea/

# Git và docs (không cần)
.git/
.gitignore
README.md
*.md  # Trừ khi cần docs

# Test/upload files (heavy, exclude để tránh treo)
uploads/
test-*.*

# Docker files (không self-include)
.dockerignore
Dockerfile.*
docker-compose.*
