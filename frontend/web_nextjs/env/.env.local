# Frontend Next.js Environment Variables

# API Configuration - The primary endpoint for all frontend requests
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Direct Service URLs (for specific cases, otherwise use API_BASE_URL)
# These use the external ports mapped in docker-compose.local.yml
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8001
NEXT_PUBLIC_CONTRACT_SERVICE_URL=http://localhost:8002
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8003
NEXT_PUBLIC_FILE_SERVICE_URL=http://localhost:8004

# Google OAuth Configuration
NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH=true
NEXT_PUBLIC_GOOGLE_CLIENT_ID=183573622288-0tu123mj11i40sgr7i0l1jsuqppnolkn.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_PROJECT_ID=docgoauthen
NEXT_PUBLIC_GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
NEXT_PUBLIC_GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:8001/login/oauth2/code/google
NEXT_PUBLIC_GOOGLE_JAVASCRIPT_ORIGINS=http://localhost:8001,http://localhost:3000

# Development Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
